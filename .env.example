# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun. ".env" git'e GİRMEZ (gizli bilgiler içerir).
#   copy .env.example .env

# --- ClickHouse (veritabanı) ---
# Sunucuda mutlaka değiştirin. Yerel geliştirmede boş bırakılırsa "tracelens" kullanılır.
CLICKHOUSE_USER=tracelens
CLICKHOUSE_PASSWORD=tracelens

# --- Bildirimler (boşsa bildirim gönderilmez) ---
# Teams: kanal > Workflows > "Post to a channel when a webhook request is received" akışının URL'si
NOTIFICATIONS_WEBHOOK_URL=
# teams | slack | generic
NOTIFICATIONS_FORMAT=teams

# --- Dashboard girişi (yalnızca "--profile app" ile; ZORUNLU, boşsa servis açılmaz) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=

# --- Dashboard (yalnızca "--profile app" ile) ---
# Bildirimlerdeki "Dashboard'da aç" linki için dashboard'un dışarıdan erişilen adresi
DASHBOARD_URL=http://localhost:8080
# Dashboard'un sunucuda yayınlanacağı port
DASHBOARD_PORT=8080
# tracelens-frontend reposunun bu klasöre göre yolu
FRONTEND_DIR=../tracelens-frontend
